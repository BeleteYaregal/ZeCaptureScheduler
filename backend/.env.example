# Copy to .env and export these (or set them in your hosting panel).
# The backend reads process.env directly, so with a plain shell run:
#   JWT_SECRET=... ADMIN_PASSWORD=... npm start

PORT=4000

# REQUIRED in production (NODE_ENV=production refuses to start without it).
# Use a long random string, for example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# First run only: the admin account that is created when the database is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# Leave DATABASE_URL empty to use a local SQLite file (backend/data/scheduler.sqlite).
# PostgreSQL: npm i pg pg-hstore   then  DATABASE_URL=postgres://user:pass@localhost:5432/scheduler
# MySQL:      npm i mysql2         then  DATABASE_URL=mysql://user:pass@localhost:3306/scheduler
DATABASE_URL=
SQLITE_PATH=

APP_TIMEZONE=Africa/Addis_Ababa

# Only needed if the web app is on a different domain than the API (comma separated). Default: allow all.
CORS_ORIGIN=*

# Telegram alerts (optional). Create a bot with @BotFather, then paste its token here.
# The bot name is found automatically. Each person connects in the app: More > Telegram alerts.
TELEGRAM_BOT_TOKEN=

# Optional: post EVERY alert to one chat or group (send /id to your bot to find the number)
TELEGRAM_CHAT_ID=
